# dotCMS instance. Include the protocol, no trailing path.
DOTCMS_HOST=http://localhost:8080

# API token from the dotCMS UI: My Account > API Access Token.
DOTCMS_AUTH_TOKEN=YOUR_API_TOKEN

# Optional. Omit to use the instance's default site.
# The id below is the demo "System Host"/starter site used by the official example.
DOTCMS_SITE_ID=59bb8831-6706-4589-9ca0-ff74016e02b2

# Uncomment only if your local dotCMS serves HTTPS with a self-signed cert.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# --- Freshdesk (helpdesk widget) -------------------------------------------
# The Freshdesk account the support board reads from.
FRESHDESK_DOMAIN=dotcms.freshdesk.com

# SECRET. Freshdesk API key: Freshdesk > Profile Settings > Your API Key.
# In dotCMS this lives on the site as `host.freshdeskApiKey`, pre-base64'd;
# put the RAW key here, the code encodes it.
FRESHDESK_API_KEY=

# Whose board to show. The VTL read this off the dotCMS session; this app has
# no session yet, so name the agent here. The email is looked up in the Staff
# content type for its `freshdeskAgentId`, then in Freshdesk directly.
FRESHDESK_AGENT_EMAIL=

# Optional. Skips the lookup above when you already know the agent id.
FRESHDESK_AGENT_ID=
